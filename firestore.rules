rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        request.auth.token.email == 'satyam088kr@gmail.com'
      );
    }

    function isApprovedStudent() {
      return isAuthenticated() && (
        getUserData().status == 'approved' ||
        isAdmin()
      );
    }

    // 1. User profiles
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.role == 'student'
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (
        isUser(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
      );
      allow delete: if isAdmin();
    }

    // 2. Courses
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Study Materials
    match /materials/{materialId} {
      allow read: if isApprovedStudent() || resource.data.isProtected == false || isAdmin();
      allow write: if isAdmin();
    }

    // 4. Live Classes
    match /live_classes/{classId} {
      allow read: if isApprovedStudent() || isAdmin();
      allow write: if isAdmin();
    }

    // 5. Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Payments
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 7. Coaching Settings & Contact Info
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
